# Server only: ~/.envs/gems-storefront/.env (0600). Never commit real values.
NODE_ENV=production
# Generate a unique hex password: openssl rand -hex 32 (URL-safe).
POSTGRES_PASSWORD=
# Docker Compose supplies DATABASE_URL, REDIS_URL and internal PORT.
COOKIE_HMAC_SECRET=
DATA_ENCRYPTION_SECRET=
PUBLIC_BASE_URL=https://getsgems.com/api
PUBLIC_FRONTEND_ORIGIN=https://getsgems.com
CATALOG_PUBLIC_GAMES=cs2,rust,tf2
CATALOG_SYNC_WORKER_INTERVAL_MS=300000
CATALOG_METADATA_WORKER_INTERVAL_MS=86400000
GEMS_CHECKOUT_ENABLED=false
GEMS_PAYMENTS_ENABLED=false
GEMS_FULFILLMENT_ENABLED=false
GUEST_STEAM_REFILL_ENABLED=false

# Runtime secrets. Entrypoint creates private *_FILE paths in container tmpfs.
# Quote values with single quotes to keep dollar signs literal in Compose.
STEAM_WEB_API_KEY=
SIH_API_KEY=
SIH_STEAM_REFILL_API_KEY=
PURELYMAIL_SMTP_HOST=smtp.purelymail.com
PURELYMAIL_SMTP_PORT=465
PURELYMAIL_SMTP_SECURE=true
PURELYMAIL_SMTP_USERNAME=support@getsgems.com
PURELYMAIL_SMTP_PASSWORD=
PURELYMAIL_SMTP_FROM=support@getsgems.com

ARCO_PAY_PROVIDER_MODE=disabled
ARCO_PAY_ENVIRONMENT=live
ARCO_PAY_API_KEY=
ARCO_PAY_BEARER_TOKEN=
# PEM public key: use a single-quoted multiline value when provided.
ARCO_PAY_PUBLIC_KEY=
ARCO_PAY_SHOP_ID=
ARCO_PAY_PAYMENT_ORIGIN=https://payment.paidlayer.com
ARCO_PAY_PUBLIC_ORIGIN=https://getsgems.com
ARCO_PAY_CALLBACK_URL=https://getsgems.com/api/payments/webhooks/arco-pay

VV_ADMIN_PUBLIC_ORIGIN=https://getsgems.com
VV_ADMIN_API_ORIGIN=https://getsgems.com/api
VV_ADMIN_SITE_KEY=
VV_ADMIN_WEBHOOK_URL=
VV_ADMIN_WEBHOOK_SITE_KEY=
VV_ADMIN_WEBHOOK_SECRET=
VV_ADMIN_INTEGRATION_SECRET=
